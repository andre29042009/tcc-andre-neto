# Chave usada somente no servidor para analisar noticias com Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Para MySQL: mysql+pymysql://usuario:senha@localhost:3306/mapc
# Omitir DATABASE_URL usa o SQLite local automaticamente.
# Periodicidade da importacao do G1 e das checagens, em horas
SYNC_INTERVAL_HOURS=24
